# Local SQLite path. Relative paths are resolved from the project root.
DATABASE_PATH=./data/contentos.db

# Trusted local MVP identity; never set from HTTP requests. Defaults to the seeded demo organization/user.
LOCAL_ORGANIZATION_ID=0198f744-8e18-7ae2-a780-52a0e20c1931
LOCAL_USER_ID=0198f744-8e18-7ae2-a780-52a0e20c1932

# OpenAI-compatible chat-completions endpoint. Leave API key empty for deterministic Mock mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_LIGHT=
LLM_MODEL_STANDARD=
LLM_MODEL_STRONG=

# OpenAI-compatible embeddings endpoint (reserved for a later phase).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
