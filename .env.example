# Local SQLite path. Relative paths are resolved from the project root.
DATABASE_PATH=./data/contentos.db

# Trusted local MVP organization and default user. In development only, an HttpOnly cookie may switch the user.
# The organization can never be selected from an HTTP request.
LOCAL_ORGANIZATION_ID=0198f744-8e18-7ae2-a780-52a0e20c1931
LOCAL_USER_ID=0198f744-8e18-7ae2-a780-52a0e20c1932

# Alibaba Cloud Model Studio (Bailian) OpenAI-compatible endpoint for Beijing.
# For production, prefer your workspace-specific regional endpoint. The endpoint and API key must be from the same region.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_LIGHT=qwen3.8-flash
LLM_MODEL_STANDARD=qwen3.7-plus
LLM_MODEL_STRONG=qwen3.8-max
LLM_TIMEOUT_MS=30000

# Bailian OpenAI-compatible embeddings endpoint. Without a key, ContentOS uses deterministic Chinese bigram/keyword vectors.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_TIMEOUT_MS=30000
